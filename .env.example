# Google Fonts Developer API key, used by the Theme Studio font picker to load
# the full font catalog (falls back to a small curated list if unset).
# Get a free key: console.cloud.google.com -> enable "Fonts Developer API" -> Credentials.
VITE_GOOGLE_FONTS_API_KEY=

# Backend URL when the frontend is hosted separately (e.g. Render static site).
# Leave empty for local dev (Vite proxies /api, /tasks, /auth to localhost:8080).
VITE_API_BASE_URL=
